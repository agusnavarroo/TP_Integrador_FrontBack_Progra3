<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

    <main>
        <!-- Formulario POST product -->
        <section class="createProduct-container">
            <h2>Crear nuevo producto</h2>

            <form id="createProductForm">
                <label for="categoryProd">Categoria</label>
                <select name="categoria" id="categoryProd" required>
                    <option value="Herramientas">Herramientas</option>
                    <option value="Fijaciones">Fijaciones</option>
                </select>

                <label for="imageProd">Imagen</label>
                <input type="text" name="imagen" id="imageProd" required>

                <label for="nameProd">Nombre</label>
                <input type="text" name="nombre" id="nameProd" required>

                <label for="priceProd">Precio</label>
                <input type="number" name="precio" id="priceProd" required>

                <input type="submit" value="Crear producto">
            </form>
        </section>

        <!-- Aca aparecen los mensajes de post.js al crear un producto -->
        <section id="contenedor-productos"></section>


        <!-- Formulario POST user (sin JavaScript, form nativo de HTML) -->
        <section class="createUser-container">
            <h2>Crear usuario admin</h2>

            <form id="createUserForm" action="/api/users" method="POST">
                <label for="nameUser">Nombre</label>
                <input type="text" name="nombre" id="nameUser" required>

                <label for="emailUser">Email</label>
                <input type="email" name="email" id="emailUser" required>

                <label for="passwordUser">Password</label>
                <input type="password" name="password" id="passwordUser" required>

                <input type="submit" value="Crear admin">
            </form>

            <!-- Mensajes que manda el controlador al renderizar la vista -->
            <% if (typeof exito !== "undefined") { %>
                <p class="mensaje exito"><%= exito %></p>
            <% } %>

            <% if (typeof error !== "undefined") { %>
                <p class="mensaje error"><%= error %></p>
            <% } %>
        </section>
    </main>

    <script src="/js/post.js"></script>

<%- include("partials/footer.ejs") %>